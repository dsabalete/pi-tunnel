telegram:
  # el token vive en el EnvironmentFile, nunca aquí
  authorized_users: [123456789]
  language: es

commands:
  aliases:
    restart-mqtt: "systemctl restart mosquitto"
    disk-usage: "df -h /"

sensors:
  - id: temp-salon
    type: dht22
    pin: 4
    interval_s: 60
    alert:
      when: "> 27.5"
      cooldown_min: 30

actuators:
  - id: luz-porche
    type: relay
    pin: 17
    confirm: false

limits:
  command_timeout_s: 10
  max_output_chars: 4000
  history_retention_days: 30