telegram:
  # el token vive en el EnvironmentFile, nunca aquí
  authorized_users: [123456789]
  language: es

commands:
  aliases:
    restart-mqtt: "systemctl restart mosquitto"
    disk-usage: "df -h /"

limits:
  command_timeout_s: 10
  max_output_chars: 4000
  history_retention_days: 30

storage:
  # Path to monitor for root disk usage.
  # ===========================================================================
  # RASPBERRY PI DOCKER SETUP
  # ===========================================================================
  # When running in Docker on Raspberry Pi:
  # - The container's "/" is the overlay filesystem (may be on NAS)
  # - The actual SD card is the host's "/" filesystem
  # - docker-compose.yml bind-mounts host "/" as "/host"
  # - Set disk_root_path to "/host" to see real SD card usage
  # ===========================================================================
  disk_root_path: "/host"
  
  # Database path (defaults to /app/data/db.sqlite3 in Docker)
  # database_path: /app/data/db.sqlite3