telegram:
  # el token vive en el EnvironmentFile, nunca aquí
  authorized_users: [123456789]
  language: es

commands:
  aliases:
    restart-mqtt: "systemctl restart mosquitto"
    disk-usage: "df -h /"

sensors:
  - id: temp-salon
    type: dht22
    pin: 4
    interval_s: 60
    alert:
      when: "> 27.5"
      cooldown_min: 30

actuators:
  - id: luz-porche
    type: relay
    pin: 17
    confirm: false

alerts:
  rules:
    - rule_id: temp-high
      sensor_id: temp-salon
      when: "> 27.5"
      cooldown_min: 30
      enabled: true

limits:
  command_timeout_s: 10
  max_output_chars: 4000
  history_retention_days: 30

storage:
  database_path: /app/data/db.sqlite3
  # Path to monitor for root disk usage. In Docker, the container's "/" is the
  # overlay filesystem which may reside on a NAS mount. Override this to point
  # at the actual SD card (e.g. a bind-mounted host path) if "/" reports NAS
  # data instead of the SD card.
  disk_root_path: "/"